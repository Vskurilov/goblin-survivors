#!/usr/bin/env python
# Сборка ядра толпы и снарядов на C++ (GDExtension). Запуск из этой папки (native):
#   scons                           — библиотека для редактора и запуска игры из него
#   scons target=template_release   — для экспорта игры в релиз
# Готовая библиотека ложится в bin/ проекта, рядом с horde_core.gdextension.
# Перед сборкой закрой Godot: открытый редактор держит старую библиотеку.
import os

if not os.path.isfile("godot-cpp/SConstruct"):
    print("Нет папки native/godot-cpp. Склонируй её отсюда (из папки native):")
    print("  git clone --branch 10.0.0-stable --depth 1 https://github.com/godotengine/godot-cpp")
    Exit(1)

env = Environment(tools=["default"], PLATFORM="")
# Классы движка, которые нужны ядру: godot-cpp собирает только их и собирается в разы быстрее.
env["build_profile"] = File("build_profile.json").abspath
env = SConscript("godot-cpp/SConstruct", {"env": env, "api_version": "4.6"})

# Числа с плавающей точкой — строго по шагам, как в движке: без слияния умножения со
# сложением в одну команду. Иначе толпа и снаряды на C++ разойдутся с GDScript в последних битах.
if env.get("is_msvc", False):
    env.Append(CCFLAGS=["/fp:precise"])
else:
    env.Append(CCFLAGS=["-ffp-contract=off"])

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "../bin/libhorde_core{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)
Default(library)
