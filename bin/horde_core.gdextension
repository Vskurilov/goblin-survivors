[configuration]

entry_symbol = "horde_core_library_init"
compatibility_minimum = "4.6"

[libraries]

windows.debug.x86_64 = "res://bin/libhorde_core.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libhorde_core.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libhorde_core.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libhorde_core.linux.template_release.x86_64.so"
